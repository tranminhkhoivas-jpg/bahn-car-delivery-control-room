    {
      "name": "Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// An employee task, no approval step. Priority: urgent (case turns red), top or normal. Urgent is allowed only by the rule\n// in plan.js (driver silent AND tracking off or car stopped); otherwise it becomes top and says why. An employee can still mark it urgent.\n// @include plan.js\nconst i = $('Start').first().json;\nconst c = $('Get context').first().json;\nconst j = $json; // check_journey\nconst reason = String(i.reason || '').trim(), task = String(i.task || '').trim(), where = String(i.last_known_location || '').trim() || (j.last_known_position ? `near ${j.last_known_position.near_city} (estimate) at ${j.last_known_position.observed_at}` : 'unknown');\nif (!c.found) return [{ json: { ok: false, error: c.error } }];\nif (!reason || !task) return [{ json: { ok: false, error: 'reason and task are required: why a person is needed and what they must do now' } }];\nlet priority = ['urgent', 'top', 'normal'].includes(String(i.priority).trim()) ? String(i.priority).trim() : 'normal', downgraded = '';\nconst silent = driverSilent(c.case_timeline);\nif (priority === 'urgent' && !urgentAllowed({ driverSilent: silent, trackingNormal: j.tracking?.normal, stopped: j.tracking?.stopped })) {\n  priority = 'top';\n  downgraded = silent ? 'not urgent: tracking looks normal and the car is moving' : 'not urgent: the driver is answering';\n}\nconst info = String(i.info || '').trim(), wf = String(i.workflow || '').trim();\n// ask_time: the answer must be a date and time (or 'not known yet'); the control room shows a date-time field for it.\nconst ask = ['ready', 'handover'].includes(String(i.ask_time || '').trim()) ? String(i.ask_time).trim() : '';\nconst STATUS = { urgent: 'urgent', top: 'needs_decision', normal: 'waiting_on_person' };\nconst open = (c.plan_steps || []).find((p) => p.proposal_id === 'task' && p.status === 'waiting_for_person' && p.detail.startsWith(task));\nif (open) return [{ json: { ok: false, error: `the same task is already open (#${open.id}); a person has it` } }];\nreturn [{ json: { ok: true, order_ref: c.order_ref, priority, downgraded,\n  case_row: { order_ref: c.order_ref, status: STATUS[priority], owner: 'operator', summary: `${priority.toUpperCase()}: ${reason}` },\n  timeline_row: { order_ref: c.order_ref, actor: 'agent', kind: 'escalation', text: `Employee task (${priority}${downgraded ? ', ' + downgraded : ''}): ${reason}. Last known location: ${where}. Task: ${task}`, source_ref: `task:${wf}` },\n  step_row: { order_ref: c.order_ref, proposal_id: 'task', step_no: '1', kind: 'staff_task', detail: `${task} (last known location: ${where})${info ? ' | Info: ' + info : ''}`, status: 'waiting_for_person', ref: priority, attempts: '0', note: `${priority}: ${reason}${wf ? ' [workflow ' + wf + ']' : ''}${ask ? ' [ask_time ' + ask + ']' : ''}`, updated_by: 'agent' } } }];"
      },
      "id": "3ee0e2b7-67be-0efa-c26a-b66369e890ed",
      "position": [
