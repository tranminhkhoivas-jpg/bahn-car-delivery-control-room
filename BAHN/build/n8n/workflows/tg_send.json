    {
      "id": "prep",
      "name": "Prep",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "// Every Telegram message goes through here. Bahn bot: messages to people (labelled who they are for, since the demo\n// shares one group). Simulated people bot (from_sim): the simulated person's reply, labelled who is speaking.\nconst snap = (() => { try { const r = $('Context').first().json; return typeof r.context === 'string' ? JSON.parse(r.context) : (r.context || {}); } catch { return {}; } })();\nconst NAMES = { buyer: snap.customer?.name || 'the buyer', delivery_contact: snap.delivery_contact?.name || 'the delivery contact', driver: (snap.assignments || []).find((a) => a.driver)?.driver || 'the driver', staff: 'Bahn staff' };\nconst ROLE = { buyer: 'Buyer', delivery_contact: 'Delivery contact', driver: 'Driver', staff: 'Staff' };\nconst i = $('Start').first().json;\nconst role = String(i.role || '').trim(), sim = String(i.from_sim) === 'true', ref = String(i.order_ref || '').trim().toUpperCase();\nlet buttons = []; try { buttons = JSON.parse(i.buttons || '[]'); } catch {}\nconst head = sim ? `${ROLE[role] || role}, ${NAMES[role] || role} (${ref}):` : role === 'staff' ? `Staff task (${ref}):` : `To ${(ROLE[role] || role).toLowerCase()} ${NAMES[role] || ''} (${ref}):`;\nconst L = $('Language').first().json;\nlet said = ''; try { said = L.need ? String($('Translate').first().json.text || '').trim() : ''; } catch {} // translation failed: English only\nconst text = said ? `${said}\\n\\n(English: ${String(i.text || '').trim()})` : String(i.text || '').trim();\nconst body = { text: `${head}\\n${text}`.slice(0, 4000) };\nif (buttons.length) body.reply_markup = { inline_keyboard: buttons.map((b) => [{ text: String(b.label).slice(0, 60), callback_data: `a:${i.proposal_id}:${b.key}`.slice(0, 64) }]) };\nif (String(i.reply_to || '').trim()) body.reply_parameters = { message_id: Number(i.reply_to), allow_sending_without_reply: true }; // bots cannot see each other, so a sim reply may not thread\nreturn [{ json: { sim, staff: role === 'staff', body, role, ref, buttons, text, language: said ? L.code : 'en' } }];"
      }
    },
    {
      "id": "send",
      "name": "Send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
