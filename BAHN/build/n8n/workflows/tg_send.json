      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "jsCode": "const p = $('Prep').first().json, i = $('Start').first().json, r = $json;\nconst ok = r.ok === true;\nreturn [{ json: { order_ref: p.ref, direction: p.sim ? 'in' : 'out', person_key: `${p.role}:${p.ref}`, role: p.role, chat_id: String(r.result?.chat?.id || ''),\n  tg_message_id: String(r.result?.message_id || ''), reply_to_tg_id: String(i.reply_to || ''), proposal_id: String(i.proposal_id || ''), kind: String(i.kind || ''),\n  text: String(p.text ?? i.text ?? ''), buttons: JSON.stringify(p.buttons), status: ok ? 'sent' : `failed: ${r.description || r.error?.message || 'no answer'}`.slice(0, 300) } }];"
      }
    },
