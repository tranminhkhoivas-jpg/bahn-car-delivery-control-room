      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $json.sim ? $env.TELEGRAM_SIM_BOT_TOKEN : $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ...$json.body, chat_id: $json.staff ? $env.TELEGRAM_STAFF_CHAT_ID : $env.TELEGRAM_DEMO_CHAT_ID }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "row",
