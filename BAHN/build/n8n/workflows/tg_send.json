      "id": "lang",
      "name": "Language",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Buyer and delivery-contact messages go out in the person's language when setting reply_in_customer_language is on.\n// The employee approved the English text; Haiku translates it here and the English stays below the translation.\nconst S = Object.fromEntries($('Settings').all().map((r) => [r.json.key, r.json.value]));\nconst snap = (() => { try { const r = $('Context').first().json; return typeof r.context === 'string' ? JSON.parse(r.context) : (r.context || {}); } catch { return {}; } })();\nconst i = $('Start').first().json, role = String(i.role || '').trim();\nconst code = String((role === 'buyer' ? snap.customer?.language : snap.delivery_contact?.language) || 'en').toLowerCase().slice(0, 2);\nconst NAME = { de: 'German', fr: 'French', fi: 'Finnish', sv: 'Swedish', et: 'Estonian', pl: 'Polish', nl: 'Dutch', it: 'Italian', es: 'Spanish' };\nconst need = String(S.reply_in_customer_language).toLowerCase() === 'on' && String(i.from_sim) !== 'true' && ['buyer', 'delivery_contact'].includes(role) && code !== 'en' && !!String(i.text || '').trim();\nconst language = NAME[code] || code; // ponytail: short name map, the model also understands a bare code\nreturn [{ json: { need, code, language, prompt: `Translate this customer message from Bahn Express into ${language}. Keep names, dates, times, prices, booking refs and option letters exactly as written. Reply with the translation only.\\n\\n${String(i.text || '').trim()}` } }];"
      }
    },
