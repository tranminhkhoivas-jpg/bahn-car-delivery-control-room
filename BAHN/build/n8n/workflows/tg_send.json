      "parameters": {
        "jsCode": "// Someone must answer this message: otr_reminders follows it up. Times are real ISO; the reminder check converts with the demo clock speed.\nconst r = $('Row').first().json;\nreturn [{ json: { order_ref: r.order_ref, who: r.role, person_key: r.person_key, about: r.kind, ref: r.proposal_id, workflow: '', since: new Date().toISOString(), reminders: '0', state: 'open', valid_until: '', last_reminded: '' } }];"
      }
