      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -100
      ],
      "parameters": {
        "jsCode": "const d = $('Check step').first().json;\nconst rows = $('Plan steps').all().map(i => i.json).filter(r => r.id);\nconst open = rows.filter(r => ['waiting_for_person', 'failed'].includes(r.status));\nconst summary = open.length ? `Plan #${d.proposal_id}: open ${open.map(r => `#${r.id} ${r.kind} (${r.status})`).join(', ')}.` : `Plan #${d.proposal_id}: all steps handled. Agent continues.`;\n// A done check before booking: the plan itself still waits for a person to approve it.\nif (!open.length && d.update.status === 'done' && $('Get step').first().json.ref === 'before_booking') return [{ json: { order_ref: d.order_ref, status: 'needs_decision', owner: 'operator', summary: `Plan #${d.proposal_id}: check before booking done. The plan can now be approved.` } }];\nreturn [{ json: { order_ref: d.order_ref, status: open.length ? (open.some(r => r.status === 'failed') ? 'needs_decision' : 'waiting_on_person') : 'in_progress', owner: open.length ? 'operator' : 'agent', summary } }];"
      }
