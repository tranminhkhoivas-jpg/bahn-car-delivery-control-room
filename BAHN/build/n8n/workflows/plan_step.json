    {
      "id": "q3",
      "name": "Check step",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// Close the loop on one plan step. Only open steps (waiting_for_person or failed) can change.\nconst req = $('Step webhook').first().json.body || {};\nconst st = $('Get step').first().json;\nconst outcome = String(req.outcome || '').toLowerCase();\nconst operator = String(req.operator || '').trim();\nconst fail = (error) => [{ json: { ok: false, error } }];\nif (!st || !st.id) return fail(`No step #${req.step_id}`);\nif (!['done', 'failed', 'retry'].includes(outcome)) return fail(\"outcome must be 'done', 'failed' or 'retry'\");\nif (!operator) return fail('operator name is required');\nif (!['waiting_for_person', 'failed'].includes(st.status)) return fail(`Step #${st.id} is ${st.status}; nothing to do.`);\nconst note = String(req.note || '').trim();\nif (outcome === 'done' && st.kind === 'buyer_decision' && !note) return fail(\"Write the buyer's answer in the note (accepted, or the time they want instead).\");\nlet update = { status: outcome, note: note || `marked ${outcome} by ${operator}`, updated_by: operator };\nif (outcome === 'retry') {\n  if (st.kind !== 'book_hotel' || st.status !== 'failed') return fail('retry works only for a failed hotel booking; a failed ferry needs a new plan from the agent');\n  // ponytail: mock provider again; simulate 'hotel_timeout' (test only) keeps failing.\n  const ok = req.simulate !== 'hotel_timeout';\n  let h = 2166136261; for (const ch of st.detail + st.attempts) h = Math.imul(h ^ ch.charCodeAt(0), 16777619);\n  update = { status: ok ? 'done' : 'failed', ref: ok ? `MOCK-HOTEL-${(h >>> 0) % 1000000}` : '', attempts: String(Number(st.attempts || 0) + 1),\n    note: ok ? `retry by ${operator}: confirmed (mock)` : `retry by ${operator}: provider timeout`, updated_by: operator };\n}\n    // An asked time (task tagged [ask_time ready|handover]): the answer is a date-time from the control room, or not known yet.\n    // A ready time after a repair gets the safety margin repair_slack_min before anything is planned from it.\n    const ask = (String(st.note || '').match(/\\[ask_time (ready|handover)\\]/) || [])[1];\n    if (outcome === 'done' && ask) {\n      const S = Object.fromEntries($('Settings').all().map((r) => [r.json.key, r.json.value]));\n      const at = Date.parse(req.time || ''), iso = (x) => new Date(x).toISOString().slice(0, 16) + 'Z';\n      if (req.time && Number.isNaN(at)) return fail('time must be a date and time');\n      const LABEL = { ready: 'Car ready at', handover: 'Driver can start driving at' };\n      const slack = ask === 'ready' ? Number(S.repair_slack_min ?? 60) : 0;\n      const said = !req.time ? `${LABEL[ask]}: not known yet` : `${LABEL[ask]}: ${iso(at)}${slack ? ` (plan from ${iso(at + slack * 6e4)}: ${slack} min safety margin, setting repair_slack_min)` : ''}`;\n      update.note = `${said}. ${note}`.trim() + ` [ask_time ${ask} ${req.time ? 'at ' + iso(at) : 'unknown'}]`;\n    }\nreturn [{ json: { ok: true, id: st.id, order_ref: st.order_ref, proposal_id: st.proposal_id, kind: st.kind, update } }];"
      }
    },
