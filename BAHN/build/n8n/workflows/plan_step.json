      "parameters": {
        "jsCode": "// The employee approved this draft (marked it done): send it. A buyer reminder on an open offer carries the option buttons again.\n// @include offer.js\nconst c = $('Check step').first().json, st = $('Get step').first().json, p = $json || {};\nlet pl = {}; try { pl = JSON.parse(JSON.parse(p.payload || '{}').detail || '{}'); } catch {}\nconst role = st.kind === 'customer_message' ? 'buyer' : 'delivery_contact';\nreturn [{ json: { order_ref: c.order_ref, role, text: st.detail, proposal_id: String(c.proposal_id || ''), kind: st.kind,\n  buttons: JSON.stringify(role === 'buyer' && p.status === 'offered' ? offerButtons(pl) : []), reply_to: '', from_sim: 'false' } }];"
      }
    },
