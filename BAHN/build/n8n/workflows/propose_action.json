    {
      "id": "pa-on",
      "name": "Offer note",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "jsCode": "// The buyer holds an offer that is now replaced: a short \"updated offer follows\" draft waits for the employee.\nconst p = $('Insert proposal').first().json;\nconst old = $('Mark offered replaced').all().map((x) => x.json.id).filter(Boolean);\n// A plan's before_booking checks are open at once: the plan cannot be approved until a person marks them done.\nlet plan = {}; try { plan = JSON.parse(JSON.parse(p.payload || '{}').detail || '{}'); } catch {}\nconst checks = (plan.steps || []).filter((s) => s.before_booking).map((s) => ({ json: { order_ref: p.order_ref, proposal_id: String(p.id), step_no: '0', kind: 'staff_task', detail: s.detail, status: 'waiting_for_person', ref: 'before_booking', attempts: '0', note: `Check before booking: plan #${p.id} cannot be approved until this is done.`, updated_by: 'propose_action' } }));\nif (!old.length) return checks.length ? checks : [{ json: { skip: true } }];\nreturn [...checks, { json: { order_ref: p.order_ref, proposal_id: String(p.id), step_no: '0', kind: 'customer_message', detail: 'Our earlier offer is no longer valid; an updated offer follows shortly.', status: 'waiting_for_person', ref: '', attempts: '0', note: `Draft: approve to send. Offer #${old.join(', #')} was replaced by plan #${p.id}.`, updated_by: 'propose_action' } }];"
      }
    },
