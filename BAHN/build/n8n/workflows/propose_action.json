    {
      "id": "p3",
      "name": "Build proposal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// A proposal is a request for a person to decide. Nothing changes until the Act workflow approves it.\nconst ACTIONS = ['customer_message', 'change_delivery_promise', 'book_recovery', 'book_travel', 'approve_cost', 'change_booking', 'reassign_driver', 'plan', 'other'];\nconst i = $('Start').first().json;\nconst c = $json;\nconst action = String(i.action || '').trim();\nconst problems = [];\nif (!c.found) problems.push(c.error || 'order not found');\nif (!ACTIONS.includes(action)) problems.push(`action must be one of ${ACTIONS.join(', ')}`);\nif (!String(i.evidence_refs || '').trim()) problems.push('evidence_refs is required: cite the ids (alerts, incidents, messages, timeline) this proposal relies on');\nif (action === 'plan' && !(() => { try { return Array.isArray(JSON.parse(i.payload).steps); } catch (e) { return false; } })()) problems.push('plan is created only by propose_plan');\nif (problems.length) return [{ json: { ok: false, error: 'NOT CREATED: ' + problems.join('; ') } }];\nconst s = c.snapshot;\n// A newer plan replaces the pending one (marked 'replaced' after insert): the newest plan always holds every event.\nconst basis = { order_status: s.order.status, last_event_id: (s.recent_events.at(-1) || {}).id || null, timeline_len: c.case_timeline.length, checked_at: new Date().toISOString() };\nreturn [{ json: { ok: true, order_ref: c.order_ref, action, payload: JSON.stringify({ summary: i.summary || '', detail: i.payload || '' }), rationale: i.rationale || '', evidence_refs: String(i.evidence_refs), status: 'pending', basis: JSON.stringify(basis), decided_by: '', decision_note: '', result: '' } }];"
      }
    },
