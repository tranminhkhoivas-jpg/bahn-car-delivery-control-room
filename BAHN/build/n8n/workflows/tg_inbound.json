    {
      "id": "decide",
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Link the message to an order: button data, else the Bahn message it replies to. Then decide what it means.\nconst b = ($('Media text').isExecuted ? $('Media text').first().json : $('Inbound webhook').first().json).body || {}, L = $('Link').first().json;\n// Linked without a reply (only open order, or a \"which order\" tap): the latest Bahn message to that person on that order stands in.\nconst outs = $('Latest out').all().map((r) => r.json).filter((r) => r && r.id).sort((x, y) => y.id - x.id);\nconst sent = L.linked ? { ...(outs[0] || {}), order_ref: L.order_ref, role: L.role } : $('Sent message').first().json;\nconst S = Object.fromEntries($('Settings').all().map((r) => [r.json.key, r.json.value]));\nconst text = L.linked === 'chosen' ? L.text : String(b.text || '').trim();\nconst [, pid = '', key = ''] = String(b.data || '').startsWith('a:') ? String(b.data).split(':') : []; // 'o:' taps only pick the order\nconst base = { linked: L.linked, from_id: String(b.from_id || ''), text, from: b.from_name || 'unknown', sim: !!b.sim, reply_to: String(b.reply_to_tg_id || ''), threshold: Number(S.glide_buyer_reply) || 0.6 };\n// ponytail: unlinked messages go to staff; matching a known Telegram user to their only open order needs real contacts.\nif (!sent?.order_ref) return [{ json: { ...base, action: L.choices?.length ? 'which' : 'unknown', order_ref: '', choices: L.choices || [] } }];\nconst role = sent.role, order_ref = sent.order_ref, proposal_id = pid || sent.proposal_id || '';\nlet buttons = []; try { buttons = JSON.parse(sent.buttons || '[]'); } catch {}\nconst d = { ...base, role, order_ref, proposal_id, buttons, asked: sent.text };\nif (role === 'driver') return [{ json: { ...d, action: 'router' } }];\n  if (role === 'staff') return [{ json: { ...d, action: 'log' } }];\n  // Reopen check: after a closed case, GLiDE decides whether a buyer or delivery-contact message raises something new.\n  if (L.closed && !key && ['buyer', 'delivery_contact'].includes(role)) return [{ json: { ...d, reopen: true, action: 'glide', glide_body: { model: 'fastino/GLiDE', store: false, state: { message: text, case: 'closed' },\n    questions: { new_issue: { type: 'noul', instructions: 'Bahn Express closed this car delivery case. Does the message raise a new problem, request or question that needs action (not just thanks, ok or a greeting)?', criteria: { true: 'Needs action', false: 'Nothing new to do' } } } } } }];\nif (role === 'buyer' && proposal_id && buttons.length) {\n  if (key) return [{ json: { ...d, action: 'act', decision: key === 'decline' ? 'buyer_decline' : 'buyer_accept', option: key === 'decline' ? '' : key } }];\n  const letter = (text.match(/\\boption\\s*([A-C])\\b/i) || text.match(/^\\s*([A-C])\\s*[.!]?\\s*$/i) || [])[1];\n  if (letter && buttons.some((x) => x.key === letter.toUpperCase())) return [{ json: { ...d, action: 'act', decision: 'buyer_accept', option: letter.toUpperCase() } }];\n}\nconst q = role === 'buyer'\n  ? { accept: { type: 'noul', instructions: 'Bahn Express offered the buyer of a car delivery a changed plan (see asked). Does the reply clearly ACCEPT the offer?', criteria: { true: 'Clearly accepts or agrees', false: 'Does not clearly accept (declines, hesitates, asks a question, unrelated)' } },\n      decline: { type: 'noul', instructions: 'Does the reply clearly DECLINE or refuse the offer?', criteria: { true: 'Clearly declines or refuses', false: 'Does not clearly decline' } } }\n  : { accept: { type: 'noul', instructions: 'Bahn Express asked the person at the delivery address to confirm a delivery change (see asked). Does the reply clearly CONFIRM it?', criteria: { true: 'Clearly confirms or agrees', false: 'Does not clearly confirm' } } };\nreturn [{ json: { ...d, action: 'glide', glide_body: { model: 'fastino/GLiDE', store: false, state: { asked: sent.text, reply: text }, questions: q } } }];"
      }
    },
