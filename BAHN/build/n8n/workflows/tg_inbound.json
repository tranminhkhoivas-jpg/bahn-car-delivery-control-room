      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        770,
        220
      ],
      "parameters": {
        "jsCode": "    // Which order a message is about. A reply or a button says it. Otherwise: the sender's only open order (from their earlier\n    // replies), several open orders -> the bot asks \"which order\" with buttons, none -> staff. A closed case is flagged for the reopen check.\n    const b = ($('Media text').isExecuted ? $('Media text').first().json : $('Inbound webhook').first().json).body, sent = $('Sent message').first().json || {};\n    const latest = {}; for (const c of $('Cases').all().map((r) => r.json).filter((r) => r && r.order_ref)) if (!latest[c.order_ref] || c.id > latest[c.order_ref].id) latest[c.order_ref] = c;\n    const isOpen = (ref) => latest[ref]?.status !== 'closed_by_agent';\n    const [k, ref = '', role = ''] = String(b.data || '').split(':');\n    if (k === 'o') return [{ json: { linked: 'chosen', order_ref: ref, role, text: String(sent.text || ''), closed: !isOpen(ref) } }]; // tap on \"which order\": the original text was stored with the question\n    if (sent.order_ref) return [{ json: { linked: '', order_ref: sent.order_ref, role: sent.role, closed: !isOpen(sent.order_ref) } }];\n    const mine = {}; for (const m of $('Sender history').all().map((r) => r.json).filter((r) => r && r.order_ref && ['buyer', 'driver', 'delivery_contact'].includes(r.role))) mine[m.order_ref] = m.role;\n    const open = Object.entries(mine).filter(([o]) => isOpen(o));\n    if (open.length === 1) return [{ json: { linked: 'only open order', order_ref: open[0][0], role: open[0][1], closed: false } }];\n    return [{ json: { linked: '', order_ref: '', role: '', choices: open.map(([o, r]) => ({ order_ref: o, role: r })), closed: false } }];"
      }
    },
