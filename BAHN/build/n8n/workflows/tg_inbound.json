    {
      "id": "mediaprompt",
      "name": "Media prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        770,
        -300
      ],
      "parameters": {
        "jsCode": "    // One model call per file. Images: Claude Haiku 5.5 describes them. Voice, audio, video and files: Gemini 3.5 Flash\n    // transcribes in the speaker's language and translates to English (OpenRouter takes audio and video as base64).\n    const m = $('Inbound webhook').first().json.body.media;\n    let b64 = '';\n    try { b64 = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('base64'); } catch { return [{ json: { request: null } }]; } // download failed (too big, expired)\n    const mime = String(m.mime || $input.first().binary?.data?.mimeType || 'application/octet-stream').split(';')[0];\n    const image = m.kind === 'photo' || mime.startsWith('image/');\n    const ask = 'This file was sent to Bahn Express, a company that delivers cars by driving them, by a driver, buyer or delivery contact. '\n      + (image ? 'Describe only what matters for the delivery: warning lights and their text, damage, the place (signs, road), documents and what they say. Facts only, no advice.'\n        : 'Transcribe what is said or written, name its language, translate it to English, and describe anything shown that matters for the delivery. Facts only.')\n      + ' Answer with JSON only: {\"language\": \"...\", \"transcript\": \"...\", \"english\": \"...\", \"description\": \"...\"}';\n    const FMT = { 'audio/ogg': 'ogg', 'audio/mpeg': 'mp3', 'audio/mp3': 'mp3', 'audio/wav': 'wav', 'audio/x-wav': 'wav', 'audio/mp4': 'm4a', 'audio/x-m4a': 'm4a', 'audio/aac': 'aac', 'audio/flac': 'flac', 'audio/webm': 'webm' };\n    const part = image ? { type: 'image_url', image_url: { url: `data:${mime};base64,${b64}` } }\n      : mime.startsWith('audio/') ? { type: 'input_audio', input_audio: { data: b64, format: FMT[mime] || 'ogg' } }\n      : mime.startsWith('video/') ? { type: 'video_url', video_url: { url: `data:${mime};base64,${b64}` } }\n      : { type: 'file', file: { filename: m.name || 'file', file_data: `data:${mime};base64,${b64}` } };\n    return [{ json: { request: { model: image ? 'anthropic/claude-haiku-5.5' : 'google/gemini-3.5-flash', temperature: 0, messages: [{ role: 'user', content: [{ type: 'text', text: ask }, part] }] } } }];"
      }
    },
    {
      "id": "describe",
      "name": "Describe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        990,
