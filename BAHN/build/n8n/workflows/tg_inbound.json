    {
      "id": "judge",
      "name": "Judge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "// GLiDE scores (threshold glide_buyer_reply). Not clear, or GLiDE down: a person reads it (employee task with a drafted question).\nconst d = $('Decide').first().json, a = $json.answers || {};\nconst acc = Number(a.accept?.noul), dec = Number(a.decline?.noul), t = d.threshold;\nconst offers = (d.buttons || []).filter((b) => b.key !== 'decline');\nif (d.reopen) { const s = Number(a.new_issue?.noul); return [{ json: { ...d, action: !(s < t) ? 'router' : 'log', note: !(s < t) ? 'new issue after the case was closed: case reopened' : 'case closed, nothing new', score: Number.isFinite(s) ? s : null } }]; } // GLiDE down: the agent looks\nif (d.role === 'buyer' && d.proposal_id && dec >= t && !(acc >= t)) return [{ json: { ...d, action: 'act', decision: 'buyer_decline', option: '', score: dec } }];\nif (d.role === 'buyer' && d.proposal_id && acc >= t && offers.length <= 1) return [{ json: { ...d, action: 'act', decision: 'buyer_accept', option: offers[0]?.key || '', score: acc } }];\nif (d.role === 'delivery_contact' && acc >= t) return [{ json: { ...d, action: 'log', note: 'delivery contact confirmed', score: acc } }];\nreturn [{ json: { ...d, action: 'task', score: Number.isFinite(acc) ? acc : null } }];"
      }
