        "jsCode": "const d = $('Route').first().json;\nconst what = { act: `${d.decision === 'buyer_decline' ? 'declines' : 'accepts'}${d.option ? ' option ' + d.option : ''}`, router: 'new driver message, sent to the agent', task: 'not clear, an employee reads it', log: d.note || 'logged', unknown: 'not linked to an order', which: 'the sender has several open orders; the bot asks which' }[d.action];\nreturn [{ json: { order_ref: d.order_ref || '-', actor: d.from, kind: 'telegram_in', text: `${d.role || 'unknown'} on Telegram: \"${d.text}\" (${what}${d.linked && d.linked !== 'chosen' ? ', linked: ' + d.linked : ''}${d.score != null ? ', GLiDE ' + d.score : ''})`, source_ref: 'tg_inbound' } }];"
