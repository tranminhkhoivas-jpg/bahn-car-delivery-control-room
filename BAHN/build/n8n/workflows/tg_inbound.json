    {
      "id": "mediatext",
      "name": "Media text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1210,
        -300
      ],
      "parameters": {
        "jsCode": "    // The model's reading goes into the message text the agents and GLiDE see; the file id stays so the control room can show it.\n    const b = $('Inbound webhook').first().json.body, m = b.media, r = $json;\n    let o = {}; try { o = JSON.parse(String(r.choices?.[0]?.message?.content || '').replace(/^[^{]*/, '').replace(/[^}]*$/, '')); } catch {}\n    const KIND = { photo: 'photo', voice: 'voice message', audio: 'audio', video: 'video', video_note: 'video message', document: 'file' }[m.kind] || 'file';\n    const heard = o.transcript ? `${o.language || 'unknown language'}: \"${o.transcript}\"${o.english && o.english !== o.transcript ? ` (English: \"${o.english}\")` : ''}` : '';\n    const said = heard || o.description ? `[${KIND}${heard ? ', ' + heard : ''}${o.description ? (heard ? '; shows: ' : ': ') + o.description : ''}]` : `[${KIND}: could not be read automatically; open it in the control room]`;\n    return [{ json: { body: { ...b, text: [String(b.text || '').trim(), said, `[media ${m.kind} ${m.file_id}]`].filter(Boolean).join('\\n') } } }];"
      }
    },
    {
      "id": "senderhistory",
