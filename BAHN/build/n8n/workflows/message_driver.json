      "parameters": {
        "jsCode": "const reply = $('Reply row').first().json.text;\nreturn [{ json: { sent: true, recipient: $('Guard').first().json.who, driver_reply: reply,\n  note: reply === '(no reply)' ? 'No answer. Ask once more; if there is still no answer, call escalate_urgent with the last known position from check_journey.' : 'Message and reply are logged on the case timeline.' } }];"
      }
