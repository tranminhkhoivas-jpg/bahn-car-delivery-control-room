      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -100
      ],
      "parameters": {
        "jsCode": "return [{ json: { order_ref: $json.order_ref, actor: $json.operator ? `staff (${$json.operator})` : 'agent', kind: $json.who === 'driver' ? 'driver_message' : 'site_message', text: `To ${$json.who}: ${$json.text}`, source_ref: 'message_driver' } }];"
      }
    },
