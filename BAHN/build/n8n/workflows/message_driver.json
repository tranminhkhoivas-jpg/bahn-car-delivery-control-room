      "id": "m2",
      "name": "Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Hard rule enforced here, not in the prompt: the agent may only write to drivers or pickup sites, never to a customer (anyone who pays).\nconst { order_ref = '', recipient_type = '', text = '' } = $json;\nconst who = String(recipient_type).trim().toLowerCase();\nconst noName = $json.from_staff && !String($json.operator || '').trim();\nconst allowed = ['driver', 'pickup_site'].includes(who) && String(text).trim().length > 0 && !noName;\nreturn [{ json: {\n  allowed, who, operator: String($json.operator || ''), order_ref: String(order_ref).trim().toUpperCase(), text: String(text).trim(),\n  refusal: allowed ? null : noName ? 'REFUSED: write your name (operator) so the driver message shows who sent it.' : !String(text).trim() ? \"REFUSED: text is empty; write the message to send.\" : `REFUSED: message_driver can only write to recipient_type 'driver' or 'pickup_site' (got '${recipient_type}'). Customer messages need a person: use propose_action with action 'customer_message'.`,\n} }];"
      }
    },
    {
      "id": "m3",
      "name": "Allowed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.allowed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "m4",
