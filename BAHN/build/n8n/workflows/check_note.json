  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "cn-start",
      "name": "Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
