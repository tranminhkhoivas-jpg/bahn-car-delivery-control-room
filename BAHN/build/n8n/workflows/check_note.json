      ],
      "parameters": {
        "jsCode": "const j = $('Judge').first().json;\nreturn [{ json: { ok: false, unclear: true, score: j.score, question: String($json.text || '').trim() || 'What exactly should change?' } }];"
      }
    },
    {
      "id": "cn-clear",
