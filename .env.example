# Copy the variable name into .env. Put real credentials only in .env.
FASTINO_API_KEY=

# n8n local API connection
N8N_API_URL=http://127.0.0.1:5678
N8N_API_KEY=

# OpenRouter API access (keep the real key only in .env)
OPENROUTER_API_KEY=

# Optional: Telegram (Bahn bot, simulated-people bot, demo group, staff group)
TELEGRAM_BOT_TOKEN=
TELEGRAM_SIM_BOT_TOKEN=
TELEGRAM_DEMO_CHAT_ID=
TELEGRAM_STAFF_CHAT_ID=

# Optional: Langfuse live prompts
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
